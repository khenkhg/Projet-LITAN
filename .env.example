# ==============================================================================
# LITAN Web Platform Environment Variables (.env.example)
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 backend frontend web

# Database (PostgreSQL 16)
POSTGRES_DB=litan
POSTGRES_USER=litan_user
POSTGRES_PASSWORD=litan_secure_password_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost http://127.0.0.1 http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost http://127.0.0.1 http://localhost:5173

# Google OAuth (ESTIN Workspace)
# Obtain these credentials from the Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
